{
  "name": "afterlife",
  "description": "Builds InfoPath Afterlife: XSN parser, classic runtime and the JSM Forms converter on Forge.",
  "prompt": "You are building InfoPath Afterlife, an open-source (MIT) app that brings retired Microsoft InfoPath forms back to life on Atlassian Forge and Jira Service Management. The steering files under .kiro/steering are the project rules; follow them. Specs live under .kiro/specs/<NN-name>/ as requirements.md, design.md and tasks.md. Work spec by spec, task by task, and keep tests green. The human reviews and commits; never commit, push or publish.",
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.85",
        "--headless",
        "--isolated",
        "--viewport-size",
        "1280x800",
        "--snapshot-mode",
        "none",
        "--image-responses",
        "omit",
        "--output-dir",
        "/tmp/afl-mcp",
        "--allowed-origins",
        "http://localhost:4331"
      ],
      "timeout": 60000
    }
  },
  "tools": [
    "read",
    "write",
    "glob",
    "grep",
    "shell",
    "code",
    "todo_list",
    "subagent",
    "introspect",
    "knowledge",
    "web_fetch",
    "web_search",
    "codegraph_explore",
    "goal",
    "@playwright"
  ],
  "allowedTools": [
    "read",
    "write",
    "glob",
    "grep",
    "shell",
    "code",
    "todo_list",
    "subagent",
    "introspect",
    "knowledge",
    "web_fetch",
    "web_search",
    "codegraph_explore",
    "goal",
    "@playwright"
  ],
  "toolsSettings": {
    "write": {
      "deniedPaths": [
        "samples/**",
        "LICENSE",
        ".git/**"
      ]
    },
    "shell": {
      "deniedCommands": [
        "git push.*",
        "git commit.*",
        "git reset.*",
        "git rebase.*",
        "git remote.*",
        "git checkout -- .*",
        "git clean.*",
        "gh .*",
        "npm publish.*",
        "pnpm publish.*",
        "forge deploy.*",
        "forge install.*",
        "sudo .*",
        "rm -rf /.*",
        "rm -rf ~.*"
      ]
    }
  },
  "hooks": {
    "preToolUse": [
      {
        "matcher": "write",
        "command": "node tools/kiro-hooks/no-secrets.mjs",
        "timeout_ms": 5000
      },
      {
        "matcher": "write",
        "command": "node tools/kiro-hooks/sample-guard.mjs",
        "timeout_ms": 5000
      },
      {
        "matcher": "shell",
        "command": "node tools/kiro-hooks/sample-guard.mjs",
        "timeout_ms": 5000
      }
    ],
    "postToolUse": [
      {
        "matcher": "write",
        "command": "node tools/kiro-hooks/format-on-write.mjs",
        "timeout_ms": 8000
      }
    ],
    "stop": [
      {
        "command": "node tools/kiro-hooks/journal-on-stop.mjs",
        "timeout_ms": 5000
      }
    ]
  },
  "resources": [
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/**/SKILL.md"
  ]
}
