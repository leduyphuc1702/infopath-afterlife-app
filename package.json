{
  "name": "infopath-afterlife",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "typecheck": "pnpm --filter @afterlife/core run typecheck && pnpm --filter web run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @afterlife/core run test",
    "test:browser": "pnpm --filter @afterlife/core run test:browser",
    "test:perf": "pnpm --filter @afterlife/core run test:perf",
    "test:hooks": "node --test tools/kiro-hooks/test/*.test.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:hooks && pnpm test && pnpm test:browser && pnpm test:web",
    "test:web": "pnpm --filter web test",
    "e2e:web": "pnpm --filter web e2e",
    "build:about": "node tools/about.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
