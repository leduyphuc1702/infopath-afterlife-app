<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic (spec 01 task 30, R21.2): two import sources that merge older forms into this one.
     Written for this project; the names are fictional. -->
<xsf:xDocumentClass solutionFormatVersion="2.0.0.0" xmlns:xsf="http://schemas.microsoft.com/office/infopath/2003/solutionDefinition" xmlns:xsf2="http://schemas.microsoft.com/office/infopath/2006/solutionDefinition/extensions" xmlns:xsf3="http://schemas.microsoft.com/office/infopath/2009/solutionDefinition/extensions">
	<xsf:package>
		<xsf:files>
			<xsf:file name="merge-v1.xsl"/>
			<xsf:file name="old-form.xsd"/>
		</xsf:files>
	</xsf:package>
	<xsf:importParameters enabled="yes" useScriptHandler="no">
		<xsf:importSource name="Old visitor form" schema="old-form.xsd" transform="merge-v1.xsl" authoringOfTransform="automatic"/>
		<xsf:importSource name="Paper intake" schema="old-form.xsd" transform="merge-v1.xsl" authoringOfTransform="manual"/>
	</xsf:importParameters>
</xsf:xDocumentClass>
