<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic (spec 01 task 30, R21.2): the browser toolbar of a Forms Services form, with the
     commands it shows. Captions are fictional. -->
<xsf:xDocumentClass solutionFormatVersion="2.0.0.0" xmlns:xsf="http://schemas.microsoft.com/office/infopath/2003/solutionDefinition" xmlns:xsf2="http://schemas.microsoft.com/office/infopath/2006/solutionDefinition/extensions" xmlns:xsf3="http://schemas.microsoft.com/office/infopath/2009/solutionDefinition/extensions">
	<xsf:extensions>
		<xsf:extension name="SolutionDefinitionExtensions">
			<xsf2:solutionDefinition runtimeCompatibility="client server">
				<xsf2:server isPreSubmitPostBackEnabled="no" isMobileEnabled="no" formLocale="en-GB">
					<xsf2:toolbar enabledTop="yes" enabledBottom="no">
						<xsf2:commands>
							<xsf2:command action="submit" caption="Send it"/>
							<xsf2:command action="close"/>
							<xsf2:command action="print" caption="Print a copy"/>
						</xsf2:commands>
					</xsf2:toolbar>
				</xsf2:server>
			</xsf2:solutionDefinition>
		</xsf:extension>
	</xsf:extensions>
</xsf:xDocumentClass>
