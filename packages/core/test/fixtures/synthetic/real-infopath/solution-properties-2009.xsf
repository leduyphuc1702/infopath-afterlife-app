<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic (spec 01 task 31, R21.3): a form published as a SharePoint list form, which records
     its mode in an xsf:extension of its own. Hosts and ids are fictional. -->
<xsf:xDocumentClass solutionFormatVersion="3.0.0.0" xmlns:xsf="http://schemas.microsoft.com/office/infopath/2003/solutionDefinition" xmlns:xsf2="http://schemas.microsoft.com/office/infopath/2006/solutionDefinition/extensions" xmlns:xsf3="http://schemas.microsoft.com/office/infopath/2009/solutionDefinition/extensions">
	<xsf:extensions>
		<xsf:extension name="SolutionDefinitionExtensions">
			<xsf2:solutionDefinition runtimeCompatibility="client server"/>
		</xsf:extension>
		<xsf:extension name="SolutionPropertiesExtension2009">
			<xsf3:solutionPropertiesExtension2009>
				<xsf3:solutionMode mode="list" isListEditForm="yes" originalPublishUrl="http://forms-legacy/sites/facilities/Lists/Rooms" originalCtid="0x0100FICTIONAL"/>
			</xsf3:solutionPropertiesExtension2009>
		</xsf:extension>
	</xsf:extensions>
</xsf:xDocumentClass>
