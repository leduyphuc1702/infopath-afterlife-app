<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic (spec 01 task 30, R21.2): where the form was last published, kept per publishing
     branch. Three branches, in an order different from MS-IPFF2's. Paths are fictional. -->
<xsf:xDocumentClass solutionFormatVersion="2.0.0.0" xmlns:xsf="http://schemas.microsoft.com/office/infopath/2003/solutionDefinition" xmlns:xsf2="http://schemas.microsoft.com/office/infopath/2006/solutionDefinition/extensions" xmlns:xsf3="http://schemas.microsoft.com/office/infopath/2009/solutionDefinition/extensions">
	<xsf:extensions>
		<xsf:extension name="SolutionDefinitionExtensions">
			<xsf2:solutionDefinition runtimeCompatibility="client server">
				<xsf2:solutionPropertiesExtension branch="wss">
					<xsf2:wss path="http://forms-legacy/sites/facilities/Requests" name="Room booking" description="Book a meeting room" browserEnable="yes"/>
					<xsf2:share formName="Room booking" path="\\files-legacy\forms\room-booking.xsn" accessPath="\\files-legacy\forms\room-booking.xsn"/>
					<xsf2:admin path="C:\publish\room-booking.xsn" site="http://forms-legacy/sites/facilities"/>
				</xsf2:solutionPropertiesExtension>
			</xsf2:solutionDefinition>
		</xsf:extension>
	</xsf:extensions>
</xsf:xDocumentClass>
