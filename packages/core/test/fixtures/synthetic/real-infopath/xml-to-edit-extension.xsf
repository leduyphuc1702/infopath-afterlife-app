<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic (spec 01 task 30, R21.2): rich-text settings per editing control, linked to the
     xmlToEdit of the same name by ref. One ref names no xmlToEdit of the view. One carries
     allowedLinkImages, admitted by anyAttribute (task 31, R21.4). -->
<xsf:xDocumentClass solutionFormatVersion="2.0.0.0" xmlns:xsf="http://schemas.microsoft.com/office/infopath/2003/solutionDefinition" xmlns:xsf2="http://schemas.microsoft.com/office/infopath/2006/solutionDefinition/extensions" xmlns:xsf3="http://schemas.microsoft.com/office/infopath/2009/solutionDefinition/extensions" xmlns:my="urn:example:room-booking">
	<xsf:views default="Main">
		<xsf:view name="Main" caption="Main">
			<xsf:editing>
				<xsf:xmlToEdit name="notes_1" item="/my:booking/my:notes">
					<xsf:editWith component="xField" type="rich"/>
				</xsf:xmlToEdit>
				<xsf:xmlToEdit name="agenda_2" item="/my:booking/my:agenda">
					<xsf:editWith component="xField" type="rich"/>
				</xsf:xmlToEdit>
			</xsf:editing>
			<xsf:mainpane transform="view1.xsl"/>
		</xsf:view>
	</xsf:views>
	<xsf:extensions>
		<xsf:extension name="SolutionDefinitionExtensions">
			<xsf2:solutionDefinition runtimeCompatibility="client">
				<xsf2:viewsExtension>
					<xsf2:viewExtension ref="Main">
						<xsf2:xmlToEditExtension ref="notes_1" allowLinkedImages="no" excludeEmbeddedImages="yes"/>
						<xsf2:xmlToEditExtension ref="agenda_2" allowLinkedImages="yes" allowedLinkImages="yes" excludeEmbeddedImages="no"/>
						<xsf2:xmlToEditExtension ref="gone_9" allowLinkedImages="no" excludeEmbeddedImages="no"/>
					</xsf2:viewExtension>
				</xsf2:viewsExtension>
			</xsf2:solutionDefinition>
		</xsf:extension>
	</xsf:extensions>
</xsf:xDocumentClass>
