	<xsd:element name="row">
		<xsd:complexType>
			<xsd:attribute name="ows_Depot" type="xsd:string"/>
			<xsd:attribute name="ows_Region" type="xsd:string"/>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
