<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic (spec 01 task 19): a global model group referenced with minOccurs="0"
     maxOccurs="unbounded", a group inside a choice, and a group that refers to itself. -->
<xsd:schema targetNamespace="urn:g" xmlns:g="urn:g" xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
	<xsd:group name="address">
		<xsd:sequence>
			<xsd:element name="street" type="xsd:string"/>
			<xsd:element name="city" type="xsd:string" minOccurs="0"/>
		</xsd:sequence>
	</xsd:group>
	<xsd:group name="contact">
		<xsd:choice><xsd:element name="phone" type="xsd:string"/><xsd:element name="email" type="xsd:string"/></xsd:choice>
	</xsd:group>
	<xsd:group name="loop">
		<xsd:sequence><xsd:element name="step" type="xsd:string"/><xsd:group ref="g:loop" minOccurs="0"/></xsd:sequence>
	</xsd:group>
	<xsd:element name="root">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:group ref="g:address" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:choice><xsd:group ref="g:contact"/><xsd:element name="none" type="xsd:boolean"/></xsd:choice>
				<xsd:element name="process"><xsd:complexType><xsd:group ref="g:loop"/></xsd:complexType></xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
