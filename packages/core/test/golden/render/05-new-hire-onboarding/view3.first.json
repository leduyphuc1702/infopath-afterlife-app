  "html": "<div class=\"afl-root\" data-afl-scope=\"s73c3687e\" style=\"BACKGROUND-COLOR:#ffffff\" inert><div><h1>New Hire Onboarding — Manager</h1></div><div><table class=\"xdFormLayout\" style=\"BORDER-COLLAPSE:collapse;TABLE-LAYOUT:fixed;WIDTH:640px\" border=\"1\"><colgroup><col style=\"WIDTH:200px\"><col style=\"WIDTH:440px\"></colgroup><tbody><tr><td colspan=\"2\" style=\"PADDING:3px 6px;BORDER:#a5a5a5 1pt solid\"><div><div class=\"xdSection xdRepeating\" title=\"New hire\" style=\"MARGIN-BOTTOM:0px;WIDTH:100%\" align=\"left\" xd:ctrlid=\"CTRL6\" xd:xctname=\"Section\"><h2>New hire</h2><table class=\"xdFormLayout\" style=\"BORDER-COLLAPSE:collapse;TABLE-LAYOUT:fixed;WIDTH:640px\" border=\"1\"><colgroup><col style=\"WIDTH:200px\"><col style=\"WIDTH:440px\"></colgroup><tbody><tr><td style=\"PADDING:3px 6px;BORDER:#a5a5a5 1pt solid\"><div>Full name</div></td><td style=\"PADDING:3px 6px;BORDER:#a5a5a5 1pt solid\"><div><span class=\"xdTextBox\" title=\"Full name\" xd:ctrlid=\"CTRL1\" xd:xctname=\"PlainText\" xd:binding=\"my:hireName\" style=\"WIDTH:100%;WHITE-SPACE:nowrap;WORD-WRAP:normal\" data-afl-ctrl=\"ctl:view3.xsl:/xsl:template[2]/div[1]/table[1]/tbody[1]/tr[1]/td[2]/div[1]/span[1]\" data-afl-path=\"/my:onboarding[1]/my:newHire[1]/my:hireName[1]\">Oscar Harrow</span></div></td></tr><tr><td style=\"PADDING:3px 6px;BORDER:#a5a5a5 1pt solid\"><div>Start date</div></td><td style=\"PADDING:3px 6px;BORDER:#a5a5a5 1pt solid\"><div><div class=\"xdDTPicker\" title=\"Start date\" style=\"WIDTH:100%\" nowrap=\"1\" xd:ctrlid=\"CTRL2\" xd:xctname=\"DTPicker\"><span class=\"xdDTText xdBehavior_FormattingNoBUI\" xd:xctname=\"DTPicker_DTText\" xd:binding=\"my:hireStartDate\" xd:boundprop=\"xd:num\" xd:datafmt=\"&quot;date&quot;,&quot;dateFormat:Short Date;&quot;\" xd:innerctrl=\"_DTText\" data-afl-ctrl=\"ctl:view3.xsl:/xsl:template[2]/div[1]/table[1]/tbody[1]/tr[2]/td[2]/div[1]/div[1]/span[1]\" data-afl-path=\"/my:onboarding[1]/my:newHire[1]/my:hireStartDate[1]\">3/1/2026</span><button class=\"xdDTButton\" xd:xctname=\"DTPicker_DTButton\" xd:innerctrl=\"_DTButton\"><span class=\"afl-icon afl-icon-calendar\" aria-hidden=\"true\"></span></button></div></div></td></tr><tr><td style=\"PADDING:3px 6px;BORDER:#a5a5a5 1pt solid\"><div>Job title</div></td><td style=\"PADDING:3px 6px;BORDER:#a5a5a5 1pt solid\"><div><span class=\"xdTextBox\" title=\"Job title\" xd:ctrlid=\"CTRL3\" xd:xctname=\"PlainText\" xd:binding=\"my:hireTitle\" style=\"WIDTH:100%;WHITE-SPACE:nowrap;WORD-WRAP:normal\" data-afl-ctrl=\"ctl:view3.xsl:/xsl:template[2]/div[1]/table[1]/tbody[1]/tr[3]/td[2]/div[1]/span[1]\" data-afl-path=\"/my:onboarding[1]/my:newHire[1]/my:hireTitle[1]\">Coordinator</span></div></td></tr><tr><td style=\"PADDING:3px 6px;BORDER:#a5a5a5 1pt solid\"><div>Department</div></td><td style=\"PADDING:3px 6px;BORDER:#a5a5a5 1pt solid\"><div><select class=\"xdComboBox xdBehavior_Select\" title=\"Department\" size=\"1\" xd:ctrlid=\"CTRL4\" xd:xctname=\"dropdown\" xd:binding=\"my:hireDept\" xd:boundprop=\"value\" style=\"WIDTH:100%\" value=\"FIN\" data-afl-ctrl=\"ctl:view3.xsl:/xsl:template[2]/div[1]/table[1]/tbody[1]/tr[4]/td[2]/div[1]/select[1]\" data-afl-path=\"/my:onboarding[1]/my:newHire[1]/my:hireDept[1]\"><option value>Select...</option><option value=\"HR\">Human Resources</option><option value=\"FIN\" selected=\"selected\">Finance</option><option value=\"IT\">Information Technology</option><option value=\"OPS\">Operations</option><option value=\"SAL\">Sales</option></select></div></td></tr><tr><td style=\"PADDING:3px 6px;BORDER:#a5a5a5 1pt solid\"><div>Manager</div></td><td style=\"PADDING:3px 6px;BORDER:#a5a5a5 1pt solid\"><div><span class=\"xdTextBox\" title=\"Manager\" xd:ctrlid=\"CTRL5\" xd:xctname=\"PlainText\" xd:binding=\"my:hireManager\" style=\"WIDTH:100%;WHITE-SPACE:nowrap;WORD-WRAP:normal\" data-afl-ctrl=\"ctl:view3.xsl:/xsl:template[2]/div[1]/table[1]/tbody[1]/tr[5]/td[2]/div[1]/span[1]\" data-afl-path=\"/my:onboarding[1]/my:newHire[1]/my:hir