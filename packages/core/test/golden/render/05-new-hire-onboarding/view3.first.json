trlid=\"CTRL13\" xd:xctname=\"PlainText\" xd:binding=\"my:relocationAllowance\" xd:boundprop=\"xd:num\" xd:datafmt=\"&quot;currency&quot;,&quot;numDigits:2;negativeOrder:0;positiveOrder:0;currencyLocale:1033;&quot;\" style=\"WIDTH:100%;WHITE-SPACE:nowrap;WORD-WRAP:normal\" data-afl-ctrl=\"ctl:view3.xsl:/xsl:template[4]/div[1]/table[1]/tbody[1]/tr[2]/td[2]/div[1]/span[1]\" data-afl-path=\"/my:onboarding[1]/my:relocation[1]/my:relocationAllowance[1]\">$8,000.00</span></div></td></tr><tr><td style=\"PADDING:3px 6px;BORDER:#a5a5a5 1pt solid\"><div>Moving date</div></td><td style=\"PADDING:3px 6px;BORDER:#a5a5a5 1pt solid\"><div><div class=\"xdDTPicker\" title=\"Moving date\" style=\"WIDTH:100%\" nowrap=\"1\" xd:ctrlid=\"CTRL14\" xd:xctname=\"DTPicker\"><span class=\"xdDTText xdBehavior_FormattingNoBUI\" xd:xctname=\"DTPicker_DTText\" xd:binding=\"my:movingDate\" xd:boundprop=\"xd:num\" xd:datafmt=\"&quot;date&quot;,&quot;dateFormat:Short Date;&quot;\" xd:innerctrl=\"_DTText\" data-afl-ctrl=\"ctl:view3.xsl:/xsl:template[4]/div[1]/table[1]/tbody[1]/tr[3]/td[2]/div[1]/div[1]/span[1]\" data-afl-path=\"/my:onboarding[1]/my:relocation[1]/my:movingDate[1]\">7/29/2026</span><button class=\"xdDTButton\" xd:xctname=\"DTPicker_DTButton\" xd:innerctrl=\"_DTButton\"><span class=\"afl-icon afl-icon-calendar\" aria-hidden=\"true\"></span></button></div></div></td></tr></tbody></table></div></div></td></tr><tr><td style=\"PADDING:3px 6px;BORDER:#a5a5a5 1pt solid\"><div>Welcome note</div></td><td style=\"PADDING:3px 6px;BORDER:#a5a5a5 1pt solid\"><div><span class=\"xdRichTextBox\" title=\"Welcome note\" xd:ctrlid=\"CTRL16\" xd:xctname=\"RichText\" xd:binding=\"my:welcomeNote\" style=\"OVERFLOW-Y:auto;WIDTH:100%;HEIGHT:70px;WORD-WRAP:break-word\" data-afl-ctrl=\"ctl:view3.xsl:/xsl:template[1]/html[1]/body[1]/div[2]/table[1]/tbody[1]/tr[4]/td[2]/div[1]/span[1]\" data-afl-path=\"/my:onboarding[1]/my:welcomeNote[1]\"><div><p>Welcome aboard, <strong>Oscar</strong>!</p><ul><li>Day 1: badge an