	<xsf:applicationParameters application="InfoPath Design Mode">
		<xsf:solutionProperties fullyEditableNamespace="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-03T08:30:00" lastOpenView="view1.xsl" automaticallyCreateNodes="yes"></xsf:solutionProperties>
	</xsf:applicationParameters>
	<xsf:documentSchemas>
		<xsf:documentSchema rootSchema="yes" location="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-03T08:30:00 myschema.xsd"></xsf:documentSchema>
	</xsf:documentSchemas>
	<xsf:fileNew>
		<xsf:initialXmlDocument caption="Purchase Request" href="template.xml"></xsf:initialXmlDocument>
	</xsf:fileNew>
	<xsf:dataObjects>
		<xsf:dataObject name="Vendors" schema="Vendors.xsd" initOnLoad="no">
			<xsf:query>
				<xsf:adoAdapter connectionString="Provider=SQLOLEDB.1;Integrated Security=SSPI;Persist Security Info=True;Initial Catalog=Purchasing;Data Source=sql-legacy01;Use Procedure for Prepare=1;Auto Translate=True;Packet Size=4096;Workstation ID=FORMS01;Use Encryption for Data=False;Tag with column collation when possible=False" commandText="select &quot;VendorID&quot;,&quot;VendorName&quot; from &quot;dbo&quot;.&quot;Vendors&quot; as &quot;Vendors&quot;" queryAllowed="yes" submitAllowed="no"></xsf:adoAdapter>
			</xsf:query>
		</xsf:dataObject>
		<xsf:dataObject name="BudgetService" schema="BudgetService.xsd" initOnLoad="no">
			<xsf:query>
				<xsf:webServiceAdapter wsdlUrl="http://forms-legacy/budget/BudgetService.asmx?WSDL" queryAllowed="yes" submitAllowed="no" name="BudgetService">
					<xsf:operation name="GetRemainingBudget" soapAction="http://forms-legacy/budget/GetRemainingBudget" serviceUrl="http://forms-legacy/budget/BudgetService.asmx">
						<xsf:input source="BudgetServiceInput.xml"></xsf:input>
					</xsf:operation>
				</xsf:webServiceAdapter>
			</xsf:query>
		</xsf:dataObject></xsf:dataObjects>
	<xsf:ruleSets>
		<xsf:ruleSet name="checkBudget">
			<xsf:rule caption="Query budget service" isEnabled="yes">
				<xsf:assignmentAction targetField="xdXDocument:GetDOM(&quot;BudgetService&quot;)/dfs:myFields/dfs:queryFields/tns:GetRemainingBudget/tns:costCenter" expression="/my:purchaseRequest/my:requester/my:costCenterCode"></xsf:assignmentAction>
				<xsf:queryAction adapter="BudgetService"></xsf:queryAction>
				<xsf:assignmentAction targetField="/my:purchaseRequest/my:budgetRemaining" expression="xdXDocument:GetDOM(&quot;BudgetService&quot;)/dfs:myFields/dfs:dataFields/tns:GetRemainingBudgetResponse/tns:GetRemainingBudgetResult"></xsf:assignmentAction>
			</xsf:rule>
		</xsf:ruleSet>
		<xsf:ruleSet name="checkApproval">
			<xsf:rule caption="Over 1000 needs accounting approval" condition="/my:purchaseRequest/my:grandTotal &gt; 1000" isEnabled="yes">
				<xsf:assignmentAction targetField="/my:purchaseRequest/my:needsAccounting" expression="&quot;true&quot;"></xsf:assignmentAction>
				<xsf:dialogBoxExpressionAction>concat(&quot;Total &quot;, /my:purchaseRequest/my:grandTotal, &quot; is over 1000: accounting must approve.&quot;)</xsf:dialogBoxExpressionAction>
			</xsf:rule>
			<xsf:rule caption="1000 or less" condition="/my:purchaseRequest/my:grandTotal &lt;= 1000" isEnabled="yes">
				<xsf:assignmentAction targetField="/my:purchaseRequest/my:needsAccounting" expression="&quot;false&quot;"></xsf:assignmentAction>
			</xsf:rule>
		</xsf:ruleSet></xsf:ruleSets>
	<xsf:calculations>
		<xsf:calculatedField target="/my:purchaseRequest/my:lines/my:line/my:lineTotal" expression="xdMath:Nz(../my:quantity) * xdMath:Nz(../my:unitPrice)" refresh="onChange"></xsf:calculatedField>
		<xsf:calculatedField target="/my:purchaseRequest/my:subtotal" expression="sum(xdMath:Nz(../my:lines/my:line/my:lineTotal))" refresh="onChange"></xsf:calculatedField>
		<xsf:calculatedField target="/my:purchaseRequest/my:vatAmount" expression="round(xdMath:Nz(../my:subtotal) * xdMath:Nz(../my:vatRate) * 100) div 100" refresh="onChange"></xsf:calculatedField>
		<xsf:calculatedField target="/my:purchaseRequest/my:grandTotal" expression="xdMath:Nz(../my:subtotal) + xdMath:Nz(../my:vatAmount)" refresh="onChange"></xsf:calculatedField>
	</xsf:calculations>
	<xsf:domEventHandlers>
	</xsf:domEventHandlers>
	<xsf:customValidation>
		<xsf:errorCondition match="/my:purchaseRequest/my:requester/my:requesterName" expressionContext="." expression=". = &quot;&quot;"><xsf:errorMessage type="modeless" shortMessage="Cannot be blank">This field is required.</xsf:errorMessage></xsf:errorCondition>
		<xsf:errorCondition match="/my:purchaseRequest/my:justification" expressionContext="." expression=". = &quot;&quot;"><xsf:errorMessage type="modeless" shortMessage="Cannot be blank">This field is required.</xsf:errorMessage></xsf:errorCondition>
		<xsf:errorCondition match="/my:purchaseRequest/my:lines/my:line/my:quantity" expressionContext="." expression=". &lt; 1"><xsf:errorMessage type="modeless" shortMessage="At least 1">Quantity must be at least 1.</xsf:errorMessage></xsf:errorCondition>
	</xsf:customValidation>
</xsf:xDocumentClass>
