	<xsf:views default="Request">
		<xsf:view name="Request" caption="Request">
			<xsf:editing>
				<xsf:xmlToEdit name="requesterName_1" item="/my:purchaseRequest/my:requester/my:requesterName"><xsf:editWith proofing="no" autoComplete="no" component="xField"></xsf:editWith></xsf:xmlToEdit>
				<xsf:xmlToEdit name="requesterEmail_2" item="/my:purchaseRequest/my:requester/my:requesterEmail"><xsf:editWith proofing="no" autoComplete="no" component="xField"></xsf:editWith></xsf:xmlToEdit>
				<xsf:xmlToEdit name="costCenterCode_3" item="/my:purchaseRequest/my:requester/my:costCenterCode"><xsf:editWith proofing="no" autoComplete="no" component="xField"></xsf:editWith></xsf:xmlToEdit>
				<xsf:xmlToEdit name="vendorId_4" item="/my:purchaseRequest/my:vendorId"><xsf:editWith proofing="no" autoComplete="no" component="xField"></xsf:editWith></xsf:xmlToEdit>
				<xsf:xmlToEdit name="neededBy_5" item="/my:purchaseRequest/my:neededBy"><xsf:editWith proofing="no" autoComplete="no" component="xField"></xsf:editWith></xsf:xmlToEdit>
				<xsf:xmlToEdit name="line_6" item="/my:purchaseRequest/my:lines/my:line" container="/my:purchaseRequest"><xsf:editWith caption="line" xd:autogeneration="template" component="xCollection"><xsf:fragmentToInsert><xsf:chooseFragment innerFragment="my:lines/my:line"><my:lines><my:line>
	<my:lineDescription></my:lineDescription>
	<my:quantity xsi:nil="true"></my:quantity>
	<my:unitPrice xsi:nil="true"></my:unitPrice>
	<my:lineTotal xsi:nil="true"></my:lineTotal>
</my:line></my:lines></xsf:chooseFragment></xsf:fragmentToInsert></xsf:editWith></xsf:xmlToEdit>
				<xsf:xmlToEdit name="lineDescription_7" item="/my:purchaseRequest/my:lines/my:line/my:lineDescription"><xsf:editWith proofing="no" autoComplete="no" component="xField"></xsf:editWith></xsf:xmlToEdit>
				<xsf:xmlToEdit name="quantity_8" item="/my:purchaseRequest/my:lines/my:line/my:quantity"><xsf:editWith proofing="no" autoComplete="no" component="xField"></xsf:editWith></xsf:xmlToEdit>
				<xsf:xmlToEdit name="unitPrice_9" item="/my:purchaseRequest/my:lines/my:line/my:unitPrice"><xsf:editWith proofing="no" autoComplete="no" component="xField"></xsf:editWith></xsf:xmlToEdit>
				<xsf:xmlToEdit name="lineTotal_10" item="/my:purchaseRequest/my:lines/my:line/my:lineTotal"><xsf:editWith proofing="no" autoComplete="no" component="xField"></xsf:editWith></xsf:xmlToEdit>
				<xsf:xmlToEdit name="subtotal_11" item="/my:purchaseRequest/my:subtotal"><xsf:editWith proofing="no" autoComplete="no" component="xField"></xsf:editWith></xsf:xmlToEdit>
