				<xsf:xmlToEdit name="vatAmount_13" item="/my:purchaseRequest/my:vatAmount"><xsf:editWith proofing="no" autoComplete="no" component="xField"></xsf:editWith></xsf:xmlToEdit>
				<xsf:xmlToEdit name="grandTotal_14" item="/my:purchaseRequest/my:grandTotal"><xsf:editWith proofing="no" autoComplete="no" component="xField"></xsf:editWith></xsf:xmlToEdit>
				<xsf:xmlToEdit name="budgetRemaining_15" item="/my:purchaseRequest/my:budgetRemaining"><xsf:editWith proofing="no" autoComplete="no" component="xField"></xsf:editWith></xsf:xmlToEdit>
				<xsf:xmlToEdit name="needsAccounting_16" item="/my:purchaseRequest/my:needsAccounting"><xsf:editWith proofing="no" autoComplete="no" component="xField"></xsf:editWith></xsf:xmlToEdit>
				<xsf:xmlToEdit name="justification_17" item="/my:purchaseRequest/my:justification"><xsf:editWith proofing="no" autoComplete="no" component="xField"></xsf:editWith></xsf:xmlToEdit>
			</xsf:editing>
			<xsf:mainpane transform="view1.xsl"></xsf:mainpane>
			<xsf:unboundControls><xsf:button name="CTRL900"><xsf:ruleSetAction ruleSet="checkBudget"></xsf:ruleSetAction></xsf:button><xsf:button name="CTRL901"><xsf:ruleSetAction ruleSet="checkApproval"></xsf:ruleSetAction></xsf:button></xsf:unboundControls>
			<xsf:menuArea name="msoStructuralEditingContextMenu">
				<xsf:button action="xCollection::insertBefore" xmlToEdit="line_6" caption="Insert line above" showIf="immediate"></xsf:button>
				<xsf:button action="xCollection::insertAfter" xmlToEdit="line_6" caption="Insert line below" showIf="immediate"></xsf:button>
				<xsf:button action="xCollection::remove" xmlToEdit="line_6" caption="Remove line" showIf="immediate"></xsf:button>
				<xsf:button action="xCollection::insert" xmlToEdit="line_6" caption="Insert line" showIf="immediate"></xsf:button>
