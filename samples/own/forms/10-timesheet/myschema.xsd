<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema targetNamespace="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-04T09:10:00" xmlns:my="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-04T09:10:00" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:element name="timesheet">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:employee"/>
				<xsd:element ref="my:lines"/>
				<xsd:element ref="my:totalHours"/>
				<xsd:element ref="my:approverEmail"/>
			</xsd:sequence>
			<xsd:anyAttribute processContents="lax" namespace="http://www.w3.org/XML/1998/namespace"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="employee">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:employeeName"/>
				<xsd:element ref="my:employeeId"/>
				<xsd:element ref="my:weekStart"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="employeeName" type="xsd:string"/>
	<xsd:element name="employeeId" type="xsd:string"/>
	<xsd:element name="weekStart" nillable="true" type="xsd:date"/>
	<xsd:element name="lines">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:day" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="day">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:workDate"/>
				<xsd:element ref="my:hoursWorked"/>
				<xsd:element ref="my:projectCode"/>
				<xsd:element ref="my:note"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="workDate" nillable="true" type="xsd:date"/>
	<xsd:element name="hoursWorked" nillable="true" type="xsd:double"/>
	<xsd:element name="projectCode" type="xsd:string"/>
	<xsd:element name="note" type="xsd:string"/>
	<xsd:element name="totalHours" nillable="true" type="xsd:double"/>
	<xsd:element name="approverEmail" type="xsd:string"/>
</xsd:schema>
