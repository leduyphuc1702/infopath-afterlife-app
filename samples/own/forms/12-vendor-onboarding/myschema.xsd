<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema targetNamespace="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-04T09:12:00" xmlns:my="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-04T09:12:00" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:element name="vendorOnboarding">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:vendor"/>
				<xsd:element ref="my:bank"/>
				<xsd:element ref="my:riskRating"/>
				<xsd:element ref="my:sanctionsChecked"/>
				<xsd:element ref="my:notes"/>
			</xsd:sequence>
			<xsd:anyAttribute processContents="lax" namespace="http://www.w3.org/XML/1998/namespace"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="vendor">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:vendorName"/>
				<xsd:element ref="my:country"/>
				<xsd:element ref="my:taxId"/>
				<xsd:element ref="my:contactEmail"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="vendorName" type="xsd:string"/>
	<xsd:element name="country" type="xsd:string"/>
	<xsd:element name="taxId" type="xsd:string"/>
	<xsd:element name="contactEmail" type="xsd:string"/>
	<xsd:element name="bank">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:bankName"/>
				<xsd:element ref="my:accountNumber"/>
				<xsd:element ref="my:currency"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="bankName" type="xsd:string"/>
	<xsd:element name="accountNumber" type="xsd:string"/>
	<xsd:element name="currency" type="xsd:string"/>
	<xsd:element name="riskRating" type="xsd:string"/>
	<xsd:element name="sanctionsChecked" type="xsd:boolean"/>
	<xsd:element name="notes">
		<xsd:complexType mixed="true">
			<xsd:sequence>
				<xsd:any minOccurs="0" maxOccurs="unbounded" namespace="http://www.w3.org/1999/xhtml" processContents="lax"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
