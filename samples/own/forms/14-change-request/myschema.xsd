<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema targetNamespace="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-04T09:14:00" xmlns:my="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-04T09:14:00" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:element name="changeRequest">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:change"/>
				<xsd:element ref="my:steps"/>
				<xsd:element ref="my:cabApproved"/>
			</xsd:sequence>
			<xsd:anyAttribute processContents="lax" namespace="http://www.w3.org/XML/1998/namespace"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="change">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:changeTitle"/>
				<xsd:element ref="my:systemAffected"/>
				<xsd:element ref="my:riskLevel"/>
				<xsd:element ref="my:plannedDate"/>
				<xsd:element ref="my:rollbackPlan"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="changeTitle" type="xsd:string"/>
	<xsd:element name="systemAffected" type="xsd:string"/>
	<xsd:element name="riskLevel" type="xsd:string"/>
	<xsd:element name="plannedDate" nillable="true" type="xsd:date"/>
	<xsd:element name="rollbackPlan" type="xsd:string"/>
	<xsd:element name="steps">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:step" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="step">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:stepOrder"/>
				<xsd:element ref="my:stepText"/>
				<xsd:element ref="my:stepOwner"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="stepOrder" nillable="true" type="xsd:integer"/>
	<xsd:element name="stepText" type="xsd:string"/>
	<xsd:element name="stepOwner" type="xsd:string"/>
	<xsd:element name="cabApproved" type="xsd:boolean"/>
</xsd:schema>
