<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema targetNamespace="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-04T09:20:00" xmlns:my="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-04T09:20:00" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:element name="courseEvaluation">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:courseName"/>
				<xsd:element ref="my:participantName"/>
				<xsd:element ref="my:score"/>
				<xsd:element ref="my:useful"/>
				<xsd:element ref="my:comments"/>
			</xsd:sequence>
			<xsd:anyAttribute processContents="lax" namespace="http://www.w3.org/XML/1998/namespace"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="courseName" type="xsd:string"/>
	<xsd:element name="participantName" type="xsd:string"/>
	<xsd:element name="score" type="xsd:string"/>
	<xsd:element name="useful" type="xsd:boolean"/>
	<xsd:element name="comments">
		<xsd:complexType mixed="true">
			<xsd:sequence>
				<xsd:any minOccurs="0" maxOccurs="unbounded" namespace="http://www.w3.org/1999/xhtml" processContents="lax"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
