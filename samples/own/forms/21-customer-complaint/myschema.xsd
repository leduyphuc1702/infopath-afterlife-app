<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema targetNamespace="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-04T09:21:00" xmlns:my="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-04T09:21:00" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:element name="customerComplaint">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:customerName"/>
				<xsd:element ref="my:customerRef"/>
				<xsd:element ref="my:receivedAt"/>
				<xsd:element ref="my:channel"/>
				<xsd:element ref="my:severity"/>
				<xsd:element ref="my:complaintText"/>
				<xsd:element ref="my:responseDue"/>
			</xsd:sequence>
			<xsd:anyAttribute processContents="lax" namespace="http://www.w3.org/XML/1998/namespace"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="customerName" type="xsd:string"/>
	<xsd:element name="customerRef" type="xsd:string"/>
	<xsd:element name="receivedAt" nillable="true" type="xsd:dateTime"/>
	<xsd:element name="channel" type="xsd:string"/>
	<xsd:element name="severity" type="xsd:string"/>
	<xsd:element name="complaintText">
		<xsd:complexType mixed="true">
			<xsd:sequence>
				<xsd:any minOccurs="0" maxOccurs="unbounded" namespace="http://www.w3.org/1999/xhtml" processContents="lax"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="responseDue" nillable="true" type="xsd:date"/>
</xsd:schema>
