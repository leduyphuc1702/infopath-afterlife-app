<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema targetNamespace="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-04T09:23:00" xmlns:my="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-04T09:23:00" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:element name="nonConformance">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:ncrNumber"/>
				<xsd:element ref="my:raisedBy"/>
				<xsd:element ref="my:raisedOn"/>
				<xsd:element ref="my:category"/>
				<xsd:element ref="my:defectText"/>
				<xsd:element ref="my:containment"/>
				<xsd:element ref="my:closed"/>
			</xsd:sequence>
			<xsd:anyAttribute processContents="lax" namespace="http://www.w3.org/XML/1998/namespace"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="ncrNumber" type="xsd:string"/>
	<xsd:element name="raisedBy" type="xsd:string"/>
	<xsd:element name="raisedOn" nillable="true" type="xsd:date"/>
	<xsd:element name="category" type="xsd:string"/>
	<xsd:element name="defectText">
		<xsd:complexType mixed="true">
			<xsd:sequence>
				<xsd:any minOccurs="0" maxOccurs="unbounded" namespace="http://www.w3.org/1999/xhtml" processContents="lax"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="containment">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:containmentAction" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="containmentAction">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:containmentDate"/>
				<xsd:element ref="my:containmentText"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="containmentDate" nillable="true" type="xsd:date"/>
	<xsd:element name="containmentText" type="xsd:string"/>
	<xsd:element name="closed" type="xsd:boolean"/>
</xsd:schema>
