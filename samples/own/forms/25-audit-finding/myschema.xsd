<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema targetNamespace="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-04T09:25:00" xmlns:my="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-04T09:25:00" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:element name="auditFinding">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:auditRef"/>
				<xsd:element ref="my:findingTitle"/>
				<xsd:element ref="my:findingType"/>
				<xsd:element ref="my:area"/>
				<xsd:element ref="my:findingText"/>
				<xsd:element ref="my:dueDate"/>
				<xsd:element ref="my:ownerEmail"/>
			</xsd:sequence>
			<xsd:anyAttribute processContents="lax" namespace="http://www.w3.org/XML/1998/namespace"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="auditRef" type="xsd:string"/>
	<xsd:element name="findingTitle" type="xsd:string"/>
	<xsd:element name="findingType" type="xsd:string"/>
	<xsd:element name="area" type="xsd:string"/>
	<xsd:element name="findingText">
		<xsd:complexType mixed="true">
			<xsd:sequence>
				<xsd:any minOccurs="0" maxOccurs="unbounded" namespace="http://www.w3.org/1999/xhtml" processContents="lax"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="dueDate" nillable="true" type="xsd:date"/>
	<xsd:element name="ownerEmail" type="xsd:string"/>
</xsd:schema>
