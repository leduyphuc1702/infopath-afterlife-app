<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema targetNamespace="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-04T09:26:00" xmlns:my="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-04T09:26:00" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:element name="meetingMinutes">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:meetingTitle"/>
				<xsd:element ref="my:meetingDate"/>
				<xsd:element ref="my:chair"/>
				<xsd:element ref="my:attendees"/>
				<xsd:element ref="my:decisions"/>
				<xsd:element ref="my:actions"/>
			</xsd:sequence>
			<xsd:anyAttribute processContents="lax" namespace="http://www.w3.org/XML/1998/namespace"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="meetingTitle" type="xsd:string"/>
	<xsd:element name="meetingDate" nillable="true" type="xsd:dateTime"/>
	<xsd:element name="chair" type="xsd:string"/>
	<xsd:element name="attendees">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:attendee" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="attendee">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:attendeeName"/>
				<xsd:element ref="my:attendeeOrg"/>
				<xsd:element ref="my:attendeePresent"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="attendeeName" type="xsd:string"/>
	<xsd:element name="attendeeOrg" type="xsd:string"/>
	<xsd:element name="attendeePresent" type="xsd:boolean"/>
	<xsd:element name="decisions">
		<xsd:complexType mixed="true">
			<xsd:sequence>
				<xsd:any minOccurs="0" maxOccurs="unbounded" namespace="http://www.w3.org/1999/xhtml" processContents="lax"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="actions">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:action" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="action">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:actionText"/>
				<xsd:element ref="my:actionOwner"/>
				<xsd:element ref="my:actionDue"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="actionText" type="xsd:string"/>
	<xsd:element name="actionOwner" type="xsd:string"/>
	<xsd:element name="actionDue" nillable="true" type="xsd:date"/>
</xsd:schema>
