<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema targetNamespace="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-04T09:27:00" xmlns:my="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-04T09:27:00" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:element name="projectCharter">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:project"/>
				<xsd:element ref="my:scope"/>
				<xsd:element ref="my:approvedOn"/>
			</xsd:sequence>
			<xsd:anyAttribute processContents="lax" namespace="http://www.w3.org/XML/1998/namespace"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="project">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:projectName"/>
				<xsd:element ref="my:sponsor"/>
				<xsd:element ref="my:startDate"/>
				<xsd:element ref="my:endDate"/>
				<xsd:element ref="my:budget"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="projectName" type="xsd:string"/>
	<xsd:element name="sponsor" type="xsd:string"/>
	<xsd:element name="startDate" nillable="true" type="xsd:date"/>
	<xsd:element name="endDate" nillable="true" type="xsd:date"/>
	<xsd:element name="budget" nillable="true" type="xsd:double"/>
	<xsd:element name="scope">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:inScope"/>
				<xsd:element ref="my:outOfScope"/>
				<xsd:element ref="my:successCriteria"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="inScope">
		<xsd:complexType mixed="true">
			<xsd:sequence>
				<xsd:any minOccurs="0" maxOccurs="unbounded" namespace="http://www.w3.org/1999/xhtml" processContents="lax"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="outOfScope">
		<xsd:complexType mixed="true">
			<xsd:sequence>
				<xsd:any minOccurs="0" maxOccurs="unbounded" namespace="http://www.w3.org/1999/xhtml" processContents="lax"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="successCriteria" type="xsd:string"/>
	<xsd:element name="approvedOn" nillable="true" type="xsd:date"/>
</xsd:schema>
