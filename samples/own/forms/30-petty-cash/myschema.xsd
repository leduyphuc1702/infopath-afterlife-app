<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema targetNamespace="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-04T09:30:00" xmlns:my="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-04T09:30:00" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:element name="pettyCash">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:claimantName"/>
				<xsd:element ref="my:claimDate"/>
				<xsd:element ref="my:items"/>
				<xsd:element ref="my:amountTotal"/>
				<xsd:element ref="my:cashierName"/>
			</xsd:sequence>
			<xsd:anyAttribute processContents="lax" namespace="http://www.w3.org/XML/1998/namespace"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="claimantName" type="xsd:string"/>
	<xsd:element name="claimDate" nillable="true" type="xsd:date"/>
	<xsd:element name="items">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:item" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="item">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:itemDate"/>
				<xsd:element ref="my:itemText"/>
				<xsd:element ref="my:itemAmount"/>
				<xsd:element ref="my:itemReceipt"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="itemDate" nillable="true" type="xsd:date"/>
	<xsd:element name="itemText" type="xsd:string"/>
	<xsd:element name="itemAmount" nillable="true" type="xsd:double"/>
	<xsd:element name="itemReceipt" nillable="true" type="xsd:base64Binary"/>
	<xsd:element name="amountTotal" nillable="true" type="xsd:double"/>
	<xsd:element name="cashierName" type="xsd:string"/>
</xsd:schema>
