<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema targetNamespace="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-04T09:31:00" xmlns:my="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-04T09:31:00" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:element name="travelPerdiem">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:travelerName"/>
				<xsd:element ref="my:destination"/>
				<xsd:element ref="my:days"/>
				<xsd:element ref="my:perDiemTotal"/>
			</xsd:sequence>
			<xsd:anyAttribute processContents="lax" namespace="http://www.w3.org/XML/1998/namespace"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="travelerName" type="xsd:string"/>
	<xsd:element name="destination" type="xsd:string"/>
	<xsd:element name="days">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:day" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="day">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:dayDate"/>
				<xsd:element ref="my:dayMeals"/>
				<xsd:element ref="my:dayLodging"/>
				<xsd:element ref="my:dayTotal"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="dayDate" nillable="true" type="xsd:date"/>
	<xsd:element name="dayMeals" nillable="true" type="xsd:double"/>
	<xsd:element name="dayLodging" nillable="true" type="xsd:double"/>
	<xsd:element name="dayTotal" nillable="true" type="xsd:double"/>
	<xsd:element name="perDiemTotal" nillable="true" type="xsd:double"/>
</xsd:schema>
