<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema targetNamespace="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-04T09:35:00" xmlns:my="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-04T09:35:00" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:element name="stationeryOrder">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:ordererName"/>
				<xsd:element ref="my:deliverTo"/>
				<xsd:element ref="my:items"/>
				<xsd:element ref="my:orderTotal"/>
			</xsd:sequence>
			<xsd:anyAttribute processContents="lax" namespace="http://www.w3.org/XML/1998/namespace"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="ordererName" type="xsd:string"/>
	<xsd:element name="deliverTo" type="xsd:string"/>
	<xsd:element name="items">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:item" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="item">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:itemText"/>
				<xsd:element ref="my:itemQty"/>
				<xsd:element ref="my:itemPrice"/>
				<xsd:element ref="my:itemTotal"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="itemText" type="xsd:string"/>
	<xsd:element name="itemQty" nillable="true" type="xsd:integer"/>
	<xsd:element name="itemPrice" nillable="true" type="xsd:double"/>
	<xsd:element name="itemTotal" nillable="true" type="xsd:double"/>
	<xsd:element name="orderTotal" nillable="true" type="xsd:double"/>
</xsd:schema>
