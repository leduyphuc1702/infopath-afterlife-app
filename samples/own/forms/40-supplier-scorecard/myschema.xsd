<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema targetNamespace="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-04T09:40:00" xmlns:my="http://schemas.microsoft.com/office/infopath/2003/myXSD/2026-11-04T09:40:00" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:element name="supplierScorecard">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:supplierName"/>
				<xsd:element ref="my:period"/>
				<xsd:element ref="my:scores"/>
				<xsd:element ref="my:scoreTotal"/>
				<xsd:element ref="my:reviewedBy"/>
			</xsd:sequence>
			<xsd:anyAttribute processContents="lax" namespace="http://www.w3.org/XML/1998/namespace"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="supplierName" type="xsd:string"/>
	<xsd:element name="period" type="xsd:string"/>
	<xsd:element name="scores">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:score" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="score">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="my:scoreArea"/>
				<xsd:element ref="my:scoreValue"/>
				<xsd:element ref="my:scoreNote"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="scoreArea" type="xsd:string"/>
	<xsd:element name="scoreValue" nillable="true" type="xsd:integer"/>
	<xsd:element name="scoreNote" type="xsd:string"/>
	<xsd:element name="scoreTotal" nillable="true" type="xsd:double"/>
	<xsd:element name="reviewedBy" type="xsd:string"/>
</xsd:schema>
